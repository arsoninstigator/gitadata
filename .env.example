# github oauth app credentials. create one at github.com/settings/developers
# with the callback url {GITADATA_BASE_URL}/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# where this server is reachable, used to build the callback url
GITADATA_BASE_URL=http://localhost:8000

# signs the session cookie. generate with:
# python3 -c "import secrets; print(secrets.token_hex(32))"
GITADATA_SECRET=

# scopes requested from the user. repo is required to force-push.
GITHUB_OAUTH_SCOPES=repo
